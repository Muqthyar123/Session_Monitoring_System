# MongoDB credentials are loaded from the repository-root .env file.
# Copy ../.env.example to ../.env and set its MONGODB_URI credentials there.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
DATABASE_NAME=college_session_monitoring_system
JWT_SECRET_KEY=<minimum-32-character-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_URL=https://session-monitoring-system.vercel.app
TIMEZONE=Asia/Kolkata
BREVO_API_KEY=<server-side-brevo-api-key>
BREVO_SENDER_MAIL=<verified-sender-email>
BREVO_SENDER_NAME=College Session Monitoring System
